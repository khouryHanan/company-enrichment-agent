# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real secrets.

# Database
DATABASE_URL=sqlite:///./agent1.db

# AI model — LangChain "provider:model" format (SCRUM-9)
# Pick one provider and set the matching API key below.
#   Gemini (free tier):    AI_MODEL=google_genai:gemini-flash-latest -> GEMINI_API_KEY
#   Anthropic:             AI_MODEL=anthropic:claude-sonnet-4-6      -> ANTHROPIC_API_KEY
#   Groq (free tier):      AI_MODEL=groq:llama-3.3-70b-versatile     -> GROQ_API_KEY
# Note: gemini-2.0-flash no longer has free-tier quota (429 with limit: 0).
AI_MODEL=google_genai:gemini-flash-latest
GEMINI_API_KEY=

# Agent 3 integration (SCRUM-10)
AGENT3_BASE_URL=http://localhost:8003

# Error handling / retries (SCRUM-13)
MAX_RETRIES=3
